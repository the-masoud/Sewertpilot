<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="../SewerPilot.OpenFlows.Adapter/SewerPilot.OpenFlows.Adapter.csproj" />
  </ItemGroup>
  <Target Name="DeployOneShotHost" AfterTargets="Build">
    <PropertyGroup>
      <_HostPlatformSubdirectory Condition="'$(Platform)' != '' And '$(Platform)' != 'AnyCPU'">$(Platform)/</_HostPlatformSubdirectory>
    </PropertyGroup>
    <ItemGroup>
      <HostFiles Include="$(TargetPath);$(TargetPath).config" />
      <HostDestination Include="$(MSBuildThisFileDirectory)../SewerPilot.OpenFlows.Adapter/bin/$(_HostPlatformSubdirectory)$(Configuration)/$(TargetFramework)/;$(MSBuildThisFileDirectory)../SewerPilot.Desktop/bin/$(_HostPlatformSubdirectory)$(Configuration)/$(TargetFramework)/;$(MSBuildThisFileDirectory)../../tests/SewerPilot.OpenFlows.Adapter.Tests/bin/$(_HostPlatformSubdirectory)$(Configuration)/$(TargetFramework)/;$(MSBuildThisFileDirectory)../../tools/probes/OpenFlowsReadOnlyModelAcceptance/bin/$(_HostPlatformSubdirectory)$(Configuration)/$(TargetFramework)/" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="%(HostDestination.Identity)" SkipUnchangedFiles="true" />
  </Target>
</Project>
