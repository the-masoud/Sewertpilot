<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADManagedDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADManagedDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADManagedDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AutoCADManagedDir)\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DManagedDir)\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="RequireAutodeskSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AutoCADManagedDir)/accoremgd.dll') Or !Exists('$(AutoCADManagedDir)/acdbmgd.dll') Or !Exists('$(AutoCADManagedDir)/acmgd.dll') Or !Exists('$(AutoCADManagedDir)/AecBaseMgd.dll') Or !Exists('$(Civil3DManagedDir)/AeccDbMgd.dll')"
           Text="The optional Civil 3D build requires licensed Autodesk managed assemblies. Set AutoCADManagedDir and Civil3DManagedDir; see CONTRIBUTING.md. Use SewerPilot.Public.slnf for the public build without Autodesk." />
  </Target>
</Project>
