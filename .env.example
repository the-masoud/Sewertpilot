# Tracked SewerPilot defaults; .env.local is developer-local and never committed.
# Prefer automatic discovery. No vendor version/build variable is intentionally present.
SEWERPILOT_ENV=Development
SEWERPILOT_LOG_LEVEL=Information
SEWERPILOT_OPENFLOWS_DISCOVERY_MODE=auto

# Optional local override; normally leave empty. Runtime discovery belongs to P1 onward.
SEWERPILOT_OPENFLOWS_HOME=
# Optional safe sample model and artifact locations; never production data or credentials.
SEWERPILOT_SAMPLE_MODEL=
SEWERPILOT_ARTIFACTS_DIR=
